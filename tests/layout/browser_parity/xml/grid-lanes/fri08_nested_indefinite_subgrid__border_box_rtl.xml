<test name="fri08_nested_indefinite_subgrid__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid-lanes" direction="rtl" align-content="start" justify-content="start" width="max-content" height="10px" grid-template-rows="10px" grid-template-columns="auto auto auto">
      <div source-tag="div" display="grid-lanes" direction="rtl" grid-template-rows="10px" grid-template-columns="subgrid" grid-row-start="1" grid-column-start="1" grid-column-end="span 3">
        <div source-tag="div" display="grid-lanes" direction="rtl" grid-template-rows="10px" grid-template-columns="subgrid" grid-row-start="1" grid-column-start="1" grid-column-end="span 3">
          <div source-tag="div" display="flex" direction="rtl" width="20px" height="10px" grid-row-start="1" grid-column-start="1"/>
          <div source-tag="div" display="flex" direction="rtl" width="40px" height="10px" grid-row-start="1" grid-column-start="3"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="60" height="10">
      <node x="0" y="0" width="60" height="10">
        <node x="0" y="0" width="60" height="10">
          <node x="40" y="0" width="20" height="10"/>
          <node x="0" y="0" width="40" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
