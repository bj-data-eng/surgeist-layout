<test name="fri05_hidden_auto_minimum__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid-lanes" box-sizing="content-box" direction="ltr" width="50px" height="20px" grid-template-columns="1fr">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15">
        <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="100px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="20">
      <node x="0" y="0" width="50" height="20" scroll_width="0" scroll_height="0">
        <node x="0" y="0" width="50" height="20"/>
      </node>
    </node>
  </expectations>
</test>
