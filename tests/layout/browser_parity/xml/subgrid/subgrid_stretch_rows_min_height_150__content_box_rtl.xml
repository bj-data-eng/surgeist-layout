<test name="subgrid_stretch_rows_min_height_150__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" grid-template-rows="100px" grid-template-columns="100px">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" align-self="baseline" min-height="150px" grid-template-rows="subgrid"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
