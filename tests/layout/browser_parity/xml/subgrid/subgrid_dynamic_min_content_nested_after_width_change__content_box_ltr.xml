<test name="subgrid_dynamic_min_content_nested_after_width_change__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" width="min-content" height="100px">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" grid-template-rows="subgrid">
        <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" writing-mode="horizontal-tb" grid-template-columns="subgrid">
          <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
