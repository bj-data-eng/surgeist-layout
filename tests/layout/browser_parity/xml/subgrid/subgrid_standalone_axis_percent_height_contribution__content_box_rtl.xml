<test name="subgrid_standalone_axis_percent_height_contribution__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" grid-template-rows="minmax(auto,100px)" grid-template-columns="100px">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" height="100%" grid-template-columns="subgrid">
        <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" height="200px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="200"/>
      </node>
    </node>
  </expectations>
</test>
