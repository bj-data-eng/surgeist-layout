<test name="subgrid_dynamic_item_height_after_change__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="rtl" width="100px" height="100px">
      <div source-tag="div" display="grid" direction="rtl" grid-template-columns="100px">
        <div source-tag="div" display="grid" direction="rtl" overflow-x="clip" overflow-y="clip" scrollbar-width="15" grid-template-columns="subgrid">
          <div source-tag="div" display="flex" direction="rtl">
            <div source-tag="div" display="flex" direction="rtl" height="100px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100">
            <node x="100" y="0" width="0" height="100"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
