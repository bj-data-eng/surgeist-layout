      <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" font-size="25px" line-height="25px" width="min-content">
        <div source-tag="div" layout-ready-anonymous-grid-text-wrapper="true" display="grid" box-sizing="content-box" direction="ltr" font-size="25px" line-height="25px" grid-template-rows="subgrid" grid-template-columns="subgrid" grid-row-start="1" grid-row-end="-1" grid-column-start="1" grid-column-end="-1">
