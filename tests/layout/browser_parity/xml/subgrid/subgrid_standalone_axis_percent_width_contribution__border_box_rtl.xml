<test name="subgrid_standalone_axis_percent_width_contribution__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="rtl" grid-template-rows="100px" grid-template-columns="minmax(auto,100px)">
      <div source-tag="div" display="grid" direction="rtl" width="100%" grid-template-rows="subgrid">
        <div source-tag="div" display="flex" direction="rtl" width="200px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="-100" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
