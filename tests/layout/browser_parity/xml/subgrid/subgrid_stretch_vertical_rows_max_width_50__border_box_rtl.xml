    <div source-tag="div" display="grid" direction="rtl" grid-template-rows="100px" grid-template-columns="100px">
      <div source-tag="div" display="grid" direction="rtl" writing-mode="vertical-rl" justify-self="baseline" max-width="50px" grid-template-rows="subgrid"/>
    </div>
  </input>
  <expectations>
