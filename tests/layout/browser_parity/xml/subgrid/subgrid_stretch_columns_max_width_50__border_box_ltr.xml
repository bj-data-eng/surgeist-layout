<test name="subgrid_stretch_columns_max_width_50__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="ltr" grid-template-rows="100px" grid-template-columns="100px">
      <div source-tag="div" display="grid" direction="ltr" justify-self="baseline" max-width="50px" grid-template-columns="subgrid"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
