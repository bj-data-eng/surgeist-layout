<test name="subgrid_standalone_axis_percent_width_contribution__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" grid-template-rows="100px" grid-template-columns="minmax(auto,100px)">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" width="100%" grid-template-rows="subgrid">
        <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="200px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
