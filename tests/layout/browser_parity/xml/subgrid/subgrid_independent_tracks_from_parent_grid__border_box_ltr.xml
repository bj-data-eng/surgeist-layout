<test name="subgrid_independent_tracks_from_parent_grid__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="ltr" row-gap="25px" column-gap="25px">
      <div source-tag="div" display="grid" direction="ltr" grid-template-columns="subgrid">
        <div source-tag="div" display="flex" direction="ltr" width="100px" height="25px"/>
        <div source-tag="div" display="flex" direction="ltr" width="100px" height="25px"/>
        <div source-tag="div" display="flex" direction="ltr" width="100px" height="25px"/>
        <div source-tag="div" display="flex" direction="ltr" width="100px" height="25px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="25"/>
        <node x="0" y="25" width="100" height="25"/>
        <node x="0" y="50" width="100" height="25"/>
        <node x="0" y="75" width="100" height="25"/>
      </node>
    </node>
  </expectations>
</test>
