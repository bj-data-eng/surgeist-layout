<test name="subgrid_auto_track_sizing_spanning_items__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="ltr" width="100px" height="100px">
      <div source-tag="div" display="grid" direction="ltr" grid-template-rows="repeat(5, 5px auto)" grid-template-columns="repeat(10, auto)">
        <div source-tag="div" display="grid" direction="ltr" grid-template-rows="subgrid" grid-template-columns="subgrid" grid-row-start="1" grid-row-end="-1" grid-column-start="1" grid-column-end="-1">
          <div source-tag="div" display="flex" direction="ltr" width="50px" height="50px" grid-row-start="span 8" grid-column-start="span 3"/>
          <div source-tag="div" display="flex" direction="ltr" width="50px" height="50px" grid-row-start="span 8" grid-column-start="span 7"/>
          <div source-tag="div" display="flex" direction="ltr" width="50px" height="50px" grid-row-start="span 2" grid-column-start="span 6"/>
          <div source-tag="div" display="flex" direction="ltr" width="50px" height="50px" grid-row-start="span 2" grid-column-start="span 4"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="50" height="50"/>
          <node x="50" y="0" width="50" height="50"/>
          <node x="0" y="50" width="50" height="50"/>
          <node x="50" y="50" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
