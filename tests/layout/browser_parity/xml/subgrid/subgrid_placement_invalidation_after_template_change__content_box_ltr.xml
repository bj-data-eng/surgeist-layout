<test name="subgrid_placement_invalidation_after_template_change__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" width="200px" grid-template-rows="100px" grid-template-columns="1fr auto">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" grid-template-columns="subgrid" grid-column-start="1" grid-column-end="-1">
        <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="50px" border-top="5px" border-left="5px" border-bottom="5px" border-right="5px" grid-column-start="2" grid-column-end="3"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="0" y="0" width="200" height="100">
        <node x="140" y="0" width="60" height="100"/>
      </node>
    </node>
  </expectations>
</test>
