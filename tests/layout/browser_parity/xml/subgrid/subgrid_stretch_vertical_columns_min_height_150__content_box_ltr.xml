  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" grid-template-rows="100px" grid-template-columns="100px">
      <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" align-self="baseline" min-height="150px" grid-template-columns="subgrid"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
