<test name="fri05_mixed_axis_clip_margin__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" overflow-x="clip" overflow-y="visible" scrollbar-width="15" overflow-clip-margin="content-box 10px" width="50px" height="50px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" width="100px" height="100px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50">
      <node x="-50" y="0" width="100" height="100"/>
    </node>
  </expectations>
</test>
