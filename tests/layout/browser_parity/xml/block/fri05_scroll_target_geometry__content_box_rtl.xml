      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" scroll-margin-top="-5px" scroll-margin-right="6px" scroll-margin-bottom="7px" scroll-margin-left="-8px" scroll-snap-align="start center" scroll-snap-stop="always" width="150px" height="150px"/>
