<test name="block_border_fixed_size_with_br__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" direction="ltr" font-size="0px" line-height="0px" width="50px" height="50px" border-top="2px" border-left="8px" border-bottom="6px" border-right="4px">
      <div source-tag="div" display="flex" direction="ltr" font-size="0px" line-height="0px" height="10px"/>
      <div source-tag="br" display="inline" direction="ltr" font-size="0px" line-height="0px" inline-baseline="0px" inline-line-height="0px"/>
      <div source-tag="div" display="flex" direction="ltr" font-size="0px" line-height="0px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50">
      <node x="8" y="2" width="38" height="10"/>
      <node x="8" y="12" width="0" height="0"/>
      <node x="8" y="12" width="38" height="10"/>
    </node>
  </expectations>
</test>
