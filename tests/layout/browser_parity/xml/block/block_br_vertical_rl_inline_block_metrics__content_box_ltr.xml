<test name="block_br_vertical_rl_inline_block_metrics__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" font-size="20px" line-height="30px" width="80px">
      <div source-tag="span" display="inline-block" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" font-size="20px" line-height="30px" width="30px" height="30px"/>
      <div source-tag="br" display="inline" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" font-size="20px" line-height="30px" inline-baseline="15px" inline-line-height="30px"/>
      <div source-tag="span" display="inline-block" box-sizing="content-box" direction="ltr" writing-mode="vertical-rl" font-size="20px" line-height="30px" width="30px" height="16px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="30">
      <node x="50" y="0" width="30" height="30"/>
      <node x="55" y="30" width="20" height="0"/>
      <node x="20" y="0" width="30" height="16"/>
    </node>
  </expectations>
</test>
