<test name="fri06_atomic_inline_baseline__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" layout-ready-inline-root="true" display="block" direction="ltr" font-family="monospace" font-size="16px" line-height="24px" width="220px">
      <div source-tag="span" display="inline-block" direction="ltr" font-family="monospace" font-size="16px" line-height="24px" width="28px" margin-bottom="6px">
        <div source-tag="span" display="block" direction="ltr" font-family="monospace" font-size="16px" line-height="24px" height="12px">
          <text layout-input="inline-text">
            <segment id="0" inline-extent="9.640625" inline-baseline="16.8" inline-line-height="24" bidi-level="0" whitespace-edge="preserve" following-break="prohibited"/>
          </text>
        </div>
      </div>
      <text layout-input="inline-text">
        <segment id="2" inline-extent="9.640625" inline-baseline="16.8" inline-line-height="24" bidi-level="0" whitespace-edge="discard-at-both" following-break="allowed"/>
      </text>
      <div source-tag="span" display="inline-block" direction="ltr" overflow-x="hidden" overflow-y="hidden" scrollbar-width="15" font-family="monospace" font-size="16px" line-height="24px" width="24px" height="30px"/>
      <text layout-input="inline-text">
        <segment id="4" inline-extent="9.640625" inline-baseline="16.8" inline-line-height="24" bidi-level="0" whitespace-edge="discard-at-both" following-break="allowed"/>
      </text>
      <div source-tag="span" display="inline-block" direction="ltr" vertical-align="top" font-family="monospace" font-size="16px" line-height="24px" width="20px" height="16px"/>
      <text layout-input="inline-text">
        <segment id="6" inline-extent="9.640625" inline-baseline="16.8" inline-line-height="24" bidi-level="0" whitespace-edge="discard-at-both" following-break="allowed"/>
      </text>
      <div source-tag="span" display="inline-block" direction="ltr" vertical-align="bottom" font-family="monospace" font-size="16px" line-height="24px" width="20px" height="28px"/>
      <atomic-placeholder child-index="0" bidi-level="0" following-break="prohibited"/>
      <atomic-placeholder child-index="2" bidi-level="0" following-break="prohibited"/>
      <atomic-placeholder child-index="4" bidi-level="0" following-break="prohibited"/>
      <atomic-placeholder child-index="6" bidi-level="0" following-break="prohibited"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="220" height="37">
      <node x="0" y="13" width="28" height="12">
        <node x="0" y="0" width="28" height="12">
          <node>
            <range-inks>
              <range-ink source_segment_id="0" line_index="0" physical_start_edge="left" start="0" advance="9.640625"/>
            </range-inks>
          </node>
        </node>
      </node>
      <node>
        <range-inks>
          <range-ink source_segment_id="2" line_index="0" physical_start_edge="left" start="28" advance="9.640625"/>
        </range-inks>
      </node>
      <node x="38" y="0" width="24" height="30" scroll_width="0" scroll_height="0"/>
      <node>
        <range-inks>
          <range-ink source_segment_id="4" line_index="0" physical_start_edge="left" start="61.640625" advance="9.640625"/>
        </range-inks>
      </node>
      <node x="71" y="0" width="20" height="16"/>
      <node>
        <range-inks>
          <range-ink source_segment_id="6" line_index="0" physical_start_edge="left" start="91.28125" advance="9.640625"/>
        </range-inks>
      </node>
      <node x="101" y="9" width="20" height="28"/>
    </node>
  </expectations>
</test>
