<test name="block_calc_width_margin__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="ltr" width="200px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="calc(50% + 20px)" height="10px" margin-left="calc(10% - 4px)" margin-right="calc(5% + 2px)"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="10">
      <node x="16" y="0" width="120" height="10"/>
    </node>
  </expectations>
</test>
