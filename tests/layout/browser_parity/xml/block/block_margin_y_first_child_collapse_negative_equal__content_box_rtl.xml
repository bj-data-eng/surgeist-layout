<test name="block_margin_y_first_child_collapse_negative_equal__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" width="50px">
      <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" margin-top="-10px">
        <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" margin-top="-10px">
          <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" height="10px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="0">
      <node x="0" y="-10" width="50" height="10">
        <node x="0" y="0" width="50" height="10">
          <node x="0" y="0" width="50" height="10"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
