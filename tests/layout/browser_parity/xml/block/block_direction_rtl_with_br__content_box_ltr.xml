<test name="block_direction_rtl_with_br__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" font-size="0px" line-height="0px" width="100px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" font-size="0px" line-height="0px" width="20px" height="10px"/>
      <div source-tag="br" display="inline" box-sizing="content-box" direction="ltr" font-size="0px" line-height="0px" inline-baseline="0px" inline-line-height="0px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" font-size="0px" line-height="0px" width="50px" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="80" y="0" width="20" height="10"/>
      <node x="100" y="10" width="0" height="0"/>
      <node x="50" y="10" width="50" height="10"/>
    </node>
  </expectations>
</test>
