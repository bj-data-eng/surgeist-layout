<test name="fri06_inline_unequal_line_alignment__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" width="160px">
      <div source-tag="div" layout-ready-inline-root="true" display="block" direction="ltr" text-align="left" font-family="monospace" font-size="16px" line-height="20px">
        <div source-tag="span" display="inline-block" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" width="24px" height="16px"/>
        <div source-tag="br" line-control="forced-break" display="inline" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" inline-baseline="15px" inline-line-height="20px"/>
        <div source-tag="span" display="inline-block" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" width="92px" height="16px"/>
        <atomic-placeholder child-index="0" bidi-level="0" following-break="prohibited"/>
        <atomic-placeholder child-index="2" bidi-level="0" following-break="prohibited"/>
      </div>
      <div source-tag="div" layout-ready-inline-root="true" display="block" direction="ltr" text-align="right" font-family="monospace" font-size="16px" line-height="20px">
        <div source-tag="span" display="inline-block" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" width="24px" height="16px"/>
        <div source-tag="br" line-control="forced-break" display="inline" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" inline-baseline="15px" inline-line-height="20px"/>
        <div source-tag="span" display="inline-block" direction="ltr" font-family="monospace" font-size="16px" line-height="20px" width="92px" height="16px"/>
        <atomic-placeholder child-index="0" bidi-level="0" following-break="prohibited"/>
        <atomic-placeholder child-index="2" bidi-level="0" following-break="prohibited"/>
