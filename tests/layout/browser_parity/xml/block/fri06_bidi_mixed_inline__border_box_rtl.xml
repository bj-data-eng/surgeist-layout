<test name="fri06_bidi_mixed_inline__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" layout-ready-inline-root="true" display="block" direction="rtl" font-family="monospace" font-size="16px" line-height="20px" width="220px">
      <inline-boundary kind="start"/>
      <text layout-input="inline-text">
        <segment id="0" inline-extent="48.171875" inline-baseline="14.8" inline-line-height="20" bidi-level="0" whitespace-edge="preserve" following-break="prohibited"/>
      </text>
      <inline-boundary kind="end"/>
      <text layout-input="inline-text">
        <segment id="2" inline-extent="9.640625" inline-baseline="14.8" inline-line-height="20" bidi-level="0" whitespace-edge="discard-at-both" following-break="allowed"/>
      </text>
      <inline-boundary kind="start"/>
      <text layout-input="inline-text">
        <segment id="0" inline-extent="28.8125" inline-baseline="14.8" inline-line-height="20" bidi-level="1" whitespace-edge="preserve" following-break="prohibited"/>
      </text>
      <inline-boundary kind="end"/>
      <text layout-input="inline-text">
        <segment id="4" inline-extent="48.171875" inline-baseline="14.8" inline-line-height="20" bidi-level="0" whitespace-edge="preserve" following-break="prohibited"/>
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="220" height="20">
      <node>
        <range-inks>
          <range-ink source_segment_id="0" line_index="0" physical_start_edge="right" start="220" advance="48.171875"/>
        </range-inks>
      </node>
      <node>
        <range-inks>
          <range-ink source_segment_id="2" line_index="0" physical_start_edge="right" start="171.828125" advance="9.640625"/>
        </range-inks>
      </node>
      <node>
        <range-inks>
          <range-ink source_segment_id="0" line_index="0" physical_start_edge="right" start="162.1875" advance="28.8125"/>
        </range-inks>
      </node>
      <node>
        <range-inks>
          <range-ink source_segment_id="4" line_index="0" physical_start_edge="right" start="133.375" advance="48.171875"/>
        </range-inks>
      </node>
    </node>
  </expectations>
</test>
