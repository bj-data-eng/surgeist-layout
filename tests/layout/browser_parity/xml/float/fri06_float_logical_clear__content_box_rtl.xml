<test name="fri06_float_logical_clear__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="block" box-sizing="content-box" direction="rtl" writing-mode="vertical-rl" overflow-x="auto" overflow-y="auto" scrollbar-width="15" width="120px" height="150px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" writing-mode="vertical-rl" float="inline-start" width="34px" height="46px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" writing-mode="vertical-rl" clear="inline-start" width="22px" height="30px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="150" scroll_width="0" scroll_height="0">
      <node x="86" y="104" width="34" height="46"/>
      <node x="64" y="120" width="22" height="30"/>
    </node>
  </expectations>
</test>
