<test name="fri07_cross_auto_margin_overflow__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="rtl" width="140px" height="80px">
      <div source-tag="div" display="flex" direction="rtl" flex-shrink="0" width="40px" height="20px" margin-top="30px" margin-bottom="30px"/>
      <div source-tag="div" display="flex" direction="rtl" overflow-x="auto" overflow-y="auto" scrollbar-width="15" flex-shrink="0" width="40px" height="100px" margin-bottom="5px">
        <div source-tag="div" display="flex" direction="rtl" width="20px" height="120px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="140" height="80">
      <node x="100" y="30" width="40" height="20"/>
      <node x="60" y="0" width="40" height="100" scroll_width="0" scroll_height="20">
        <node x="20" y="0" width="20" height="120"/>
      </node>
    </node>
  </expectations>
</test>
