<test name="fri07_collapsed_strut_single_line__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" align-items="baseline" width="180px">
      <text source-tag="div" display="flex" box-sizing="content-box" direction="rtl" flex-shrink="0" width="30px" height="20px">
        base
      </text>
      <text source-tag="div" display="flex" box-sizing="content-box" direction="rtl" flex-item-collapse="collapsed" flex-shrink="0" width="40px" height="40px">
        small strut
      </text>
      <text source-tag="div" display="flex" box-sizing="content-box" direction="rtl" flex-shrink="0" width="30px" height="25px">
        peer
      </text>
      <text source-tag="div" display="flex" box-sizing="content-box" direction="rtl" flex-item-collapse="collapsed" flex-shrink="0" width="50px" height="60px">
        large strut
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="180" height="60">
      <node x="150" y="0" width="30" height="20"/>
      <node x="110" y="0" width="40" height="40"/>
      <node x="80" y="0" width="30" height="25"/>
      <node x="30" y="0" width="50" height="60"/>
    </node>
  </expectations>
</test>
