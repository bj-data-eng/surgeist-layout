<test name="fri07_intrinsic_flex_basis__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="rtl" flex-direction="column" width="260px" row-gap="10px" column-gap="10px">
      <div source-tag="div" display="flex" direction="rtl" width="260px">
        <text source-tag="div" display="flex" direction="rtl" flex-grow="1" flex-basis="min-content" min-width="0px">
          alpha beta gamma
        </text>
        <text source-tag="div" display="flex" direction="rtl" flex-grow="1" flex-basis="max-content" min-width="0px">
          alpha beta gamma
        </text>
      </div>
      <div source-tag="div" display="flex" direction="rtl" width="120px">
        <text source-tag="div" display="flex" direction="rtl" flex-grow="1" flex-basis="min-content" min-width="0px">
          longword short tail
        </text>
        <text source-tag="div" display="flex" direction="rtl" flex-grow="1" flex-basis="max-content" min-width="0px">
          longword short tail
        </text>
      </div>
    </div>
  </input>
  <expectations>
