      <node x="0" y="0" width="260" height="30">
        <node x="185" y="0" width="75" height="30"/>
        <node x="0" y="0" width="185" height="30"/>
      </node>
      <node x="140" y="40" width="120" height="30">
        <node x="84" y="0" width="36" height="30"/>
        <node x="0" y="0" width="84" height="30"/>
      </node>
    </node>
