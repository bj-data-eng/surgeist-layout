  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="200px" height="20px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" flex-shrink="0" flex-basis="content" width="90px" height="20px" min-width="0px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" flex-shrink="0" width="40px" height="20px" min-width="0px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="0" y="0" width="0" height="20"/>
      <node x="0" y="0" width="40" height="20"/>
    </node>
  </expectations>
</test>
