<test name="fri05_nested_zero_axis_overflow__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" overflow-x="auto" overflow-y="auto" scrollbar-width="15" width="100px" height="100px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" flex-shrink="0" width="0px" height="0px">
        <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" width="0px" height="200px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
      <node x="100" y="0" width="0" height="0">
        <node x="0" y="0" width="0" height="200"/>
      </node>
    </node>
  </expectations>
</test>
