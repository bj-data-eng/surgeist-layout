<test name="flex_calc_basis_margin_gap__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="ltr" width="240px" row-gap="calc(5% + 2px)" column-gap="calc(5% + 2px)">
      <div source-tag="div" display="flex" direction="ltr" flex-shrink="0" flex-basis="calc(25% + 12px)" height="10px" margin-left="calc(10% - 6px)"/>
      <div source-tag="div" display="flex" direction="ltr" width="calc(30% + 4px)" height="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="240" height="10">
      <node x="18" y="0" width="72" height="10"/>
      <node x="104" y="0" width="76" height="10"/>
    </node>
  </expectations>
</test>
