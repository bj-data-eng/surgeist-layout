<test name="xaspect_ratio_flex_row_stretch_fill_min_width__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="flex" direction="rtl" width="100px" height="100px">
      <text source-tag="div" display="flex" direction="rtl" min-height="40px" aspect-ratio="2">
        
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="-100" y="0" width="200" height="100"/>
    </node>
  </expectations>
</test>
