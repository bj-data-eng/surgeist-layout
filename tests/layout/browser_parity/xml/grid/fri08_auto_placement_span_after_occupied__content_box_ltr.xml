<test name="fri08_auto_placement_span_after_occupied__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="ltr" align-content="start" justify-content="start" width="120px" grid-template-rows="20px" grid-template-columns="40px 40px 40px" grid-auto-rows="20px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="40px" height="20px" grid-row-start="1" grid-column-start="2"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="ltr" width="80px" height="20px" grid-column-start="span 2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="40">
      <node x="40" y="0" width="40" height="20"/>
      <node x="0" y="20" width="80" height="20"/>
    </node>
  </expectations>
</test>
