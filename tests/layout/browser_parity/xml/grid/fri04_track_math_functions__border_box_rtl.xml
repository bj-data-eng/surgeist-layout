<test name="fri04_track_math_functions__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="rtl" justify-content="start" width="240px" grid-template-rows="20px" grid-template-columns="minmax(calc(25% + 10px),calc(35% + 16px)) fit-content(calc(25% + 15px))">
      <div source-tag="div" display="flex" direction="rtl" width="90px" height="20px" min-width="0px"/>
      <div source-tag="div" display="flex" direction="rtl" width="120px" height="20px" min-width="0px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="240" height="20">
      <node x="150" y="0" width="90" height="20"/>
      <node x="20" y="0" width="120" height="20"/>
    </node>
  </expectations>
</test>
