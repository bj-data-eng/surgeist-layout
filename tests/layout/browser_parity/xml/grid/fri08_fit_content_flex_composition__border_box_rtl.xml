<test name="fri08_fit_content_flex_composition__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="rtl" align-content="start" justify-content="stretch" width="200px" height="20px" grid-template-rows="20px" grid-template-columns="fit-content(50px) 0.5fr minmax(0px,auto)">
      <div source-tag="div" display="flex" direction="rtl" width="20px" height="20px"/>
      <div source-tag="div" display="flex" direction="rtl" height="20px" min-width="0px"/>
      <div source-tag="div" display="flex" direction="rtl" height="20px" min-width="0px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="20">
      <node x="180" y="0" width="20" height="20"/>
      <node x="90" y="0" width="90" height="20"/>
      <node x="0" y="0" width="90" height="20"/>
    </node>
  </expectations>
</test>
