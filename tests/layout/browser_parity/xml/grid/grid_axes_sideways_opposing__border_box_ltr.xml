<test name="grid_axes_sideways_opposing__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="ltr" writing-mode="sideways-rl" grid-template-rows="50px 60px" grid-template-columns="30px 40px">
      <div source-tag="div" display="flex" direction="ltr" writing-mode="sideways-lr" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
      <div source-tag="div" display="flex" direction="ltr" writing-mode="sideways-lr" grid-row-start="2" grid-row-end="3" grid-column-start="2" grid-column-end="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="110" height="70">
      <node x="60" y="0" width="50" height="30"/>
      <node x="0" y="30" width="60" height="40"/>
    </node>
  </expectations>
</test>
