<test name="grid_aspect_ratio_fill_child_height__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" direction="rtl" width="100px" height="100px">
      <div source-tag="div" display="flex" direction="rtl" width="50px" aspect-ratio="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="50" y="0" width="50" height="25"/>
    </node>
  </expectations>
</test>
