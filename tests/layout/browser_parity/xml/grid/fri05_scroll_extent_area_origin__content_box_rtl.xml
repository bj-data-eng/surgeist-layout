<test name="fri05_scroll_extent_area_origin__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" overflow-x="auto" overflow-y="auto" scrollbar-width="15" width="100px" height="50px" grid-template-columns="50px 50px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" width="80px" height="20px" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="50" scroll_width="30" scroll_height="0">
      <node x="-30" y="0" width="80" height="20"/>
    </node>
  </expectations>
</test>
