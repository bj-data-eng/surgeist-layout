  <input>
    <div source-tag="div" display="grid" direction="rtl" grid-template-columns="auto auto">
      <text source-tag="div" display="flex" direction="rtl">
        HH​HH​HH​HH
      </text>
      <text source-tag="div" display="flex" direction="rtl">
        HH​HH​HH​HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="160" height="10">
      <node x="80" y="0" width="80" height="10"/>
      <node x="0" y="0" width="80" height="10"/>
    </node>
  </expectations>
</test>
