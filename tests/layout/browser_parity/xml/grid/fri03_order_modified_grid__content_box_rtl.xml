<test name="fri03_order_modified_grid__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div source-tag="div" display="grid" box-sizing="content-box" direction="rtl" width="80px" height="20px" grid-template-rows="20px" grid-template-columns="20px 20px 20px 20px">
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" order="2" width="20px" height="20px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" order="-1" width="20px" height="20px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" order="2" width="20px" height="20px"/>
      <div source-tag="div" display="flex" box-sizing="content-box" direction="rtl" width="20px" height="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="80" height="20">
      <node x="20" y="0" width="20" height="20"/>
      <node x="60" y="0" width="20" height="20"/>
      <node x="0" y="0" width="20" height="20"/>
      <node x="40" y="0" width="20" height="20"/>
    </node>
  </expectations>
</test>
